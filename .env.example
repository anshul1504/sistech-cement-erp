# Copy to .env for local use. Environment variables override local .env values.
# Never commit real credentials. Generate a unique DJANGO_SECRET_KEY.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# Production only:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.your-company.com
# DJANGO_BEHIND_HTTPS_PROXY=1
# DJANGO_HSTS_SECONDS=31536000

# OTP is required by default, including admin login.
EMAIL_OTP_ENABLED=1
# 1 = username + password signs in directly, email + password needs OTP.
# 0 = OTP for every sign-in (default when DJANGO_DEBUG=0).
EMAIL_OTP_SKIP_FOR_USERNAME=1
# Local evaluation: console backend. Configure SMTP to deliver real emails.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# SMTP over implicit SSL uses port 465 and STARTTLS off.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.your-company.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=1
# EMAIL_USE_TLS=0
# EMAIL_HOST_USER=no-reply@your-company.com
# EMAIL_HOST_PASSWORD=set-in-local-env-only
# DEFAULT_FROM_EMAIL=Sistech ERP <no-reply@your-company.com>
