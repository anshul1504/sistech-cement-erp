# These variables must be set in the shell or deployment environment.
# Django does not automatically load this file.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Development: recovery email is printed in the server console, not delivered.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Configure the SMTP backend only when email delivery is approved and ready.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=your-service-account
# EMAIL_HOST_PASSWORD=configure-in-environment-only
# DEFAULT_FROM_EMAIL=Sistech ERP <no-reply@your-company.com>

# OTP integration is commented out in accounts/otp.py and config/settings.py.
# There is no active OTP endpoint or login challenge.
